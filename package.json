{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev --webpack",
    "build": "cross-env INIT_CWD=$PWD next build --webpack && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx --fix app components context lib layouts scripts",
    "test:unit": "node --test --import tsx tests/unit/*.test.ts",
    "mcp:supabase": "npx -y @supabase/mcp-server-postgrest",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "mcp:devtools": "chrome-devtools-mcp"
  },
  "dependencies": {
    "@algolia/client-search": "^4.24.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/is-prop-valid": "^1.2.2",
    "@formkit/drag-and-drop": "^0.5.3",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "2.2.0",
    "@heroicons/react": "^2.2.0",
    "@next/bundle-analyzer": "15.2.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@stripe/stripe-js": "^8.6.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.3",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/oxide": "^4.1.18",
    "@tailwindcss/postcss": "^4.0.5",
    "@tailwindcss/typography": "^0.5.15",
    "@types/canvas-confetti": "^1.9.0",
    "@types/lodash": "^4.17.21",
    "@vercel/analytics": "^1.5.0",
    "algoliasearch": "^4.24.0",
    "body-scroll-lock": "^4.0.0-beta.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "contentlayer2": "0.5.5",
    "driver.js": "^1.4.0",
    "esbuild": "0.25.2",
    "framer-motion": "^12.23.24",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.0.1",
    "lightningcss": "^1.30.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.556.0",
    "next": "^16.0.7",
    "next-contentlayer2": "0.5.5",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.4.24",
    "raw-body": "^3.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-grid-layout": "^2.1.0",
    "react-markdown": "^10.1.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.0",
    "rehype-katex": "^7.0.0",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "search-insights": "^2.13.0",
    "stripe": "^20.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.5",
    "undici": "^7.16.0",
    "unist-util-visit": "^5.0.0",
    "use-sound": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.16.0",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/tailwind4": "^1.2.0",
    "@playwright/test": "^1.57.0",
    "@svgr/webpack": "^8.0.1",
    "@types/mdx": "^2.0.12",
    "@types/react": "^19.0.8",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "chrome-devtools-mcp": "^0.12.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^15.12.0",
    "husky": "^9.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "supabase-mcp": "^1.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
